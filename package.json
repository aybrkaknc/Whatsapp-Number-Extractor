{
  "name": "whatsapp-number-extractor",
  "version": "1.3.0",
  "description": "Firefox and Chrome extension that exports WhatsApp Web group member numbers to CSV",
  "main": "src/main.js",
  "scripts": {
    "start": "web-ext run --firefox-profile=.dev-profile --profile-create-if-missing --keep-profile-changes",
    "start:chrome": "web-ext run --target=chromium",
    "lint": "web-ext lint",
    "build": "web-ext build --overwrite-dest",
    "test": "node --test \"test/*.test.js\""
  },
  "devDependencies": {
    "web-ext": "^10.0.0"
  },
  "webExt": {
    "ignoreFiles": [
      "icon/og.png",
      "package.json",
      "package-lock.json",
      "README.md",
      "README.tr.md",
      "PRIVACY.md",
      "PRIVACY.tr.md",
      "docs/**",
      "store/**",
      "*.xpi",
      "test/**"
    ]
  }
}
