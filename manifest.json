{
  "manifest_version": 3,
  "name": "WhatsApp Number Extractor",
  "version": "1.1",
  "description": "Grup \u00fcyelerinden telefon numaralar\u0131n\u0131 toplay\u0131p CSV olarak indir.",
  "permissions": [
    "activeTab"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://web.whatsapp.com/*"
      ],
      "css": [
        "98-scoped.css"
      ],
      "js": [
        "content.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.woff",
        "*.woff2"
      ],
      "matches": [
        "*://*.whatsapp.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{84f32af9-a587-477b-92cc-3d195c953f7e}"
    }
  }
}