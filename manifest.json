        "src/settings.js",
        "src/session.js",
        "src/country.js",
        "src/logger.js",
        "src/scanner.js",
        "src/export.js",
        "src/ui/template.js",
        "src/ui/texts.js",
        "src/ui/window.js",
        "src/ui/actions.js",
        "src/ui/create.js",
        "src/main.js"
      ]
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "*.woff",
        "*.woff2",
        "help-en.html",
        "help-tr.html",
        "98.css"
      ],
      "matches": [
        "https://web.whatsapp.com/*"
      ]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "{84f32af9-a587-477b-92cc-3d195c953f7e}",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
